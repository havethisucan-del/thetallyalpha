# Web client configuration (Vite). Copy to apps/web/.env.local to override. No secrets here:
# every VITE_ variable referenced from client code is embedded in the public bundle.

# Dev/preview server only: where /api, /healthz and /readyz are proxied to.
VITE_API_PROXY_TARGET=http://127.0.0.1:2567

# Colyseus game server URL used by the browser SDK.
# Unset: http://127.0.0.1:2567 in dev, the page's own origin in production builds.
# Set to an empty value to always use the page's own origin (same-origin deployment).
# A value starting with "/" is a path on the page's own origin, e.g. /colyseus: the Vite dev
# server proxies /colyseus/* (HTTP and WebSockets) to VITE_API_PROXY_TARGET. `pnpm dev:lan`
# sets VITE_GAME_SERVER_URL=/colyseus itself so LAN devices only need the web port (ADR-0013).
VITE_GAME_SERVER_URL=http://127.0.0.1:2567
