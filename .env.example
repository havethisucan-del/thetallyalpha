# Copy to .env and replace placeholder values. .env is git-ignored; never commit real secrets.

# --- Local dev PostgreSQL (pnpm db:start, embedded-postgres; password is fixed at first start)
POSTGRES_USER=cartignon
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=cartignon
POSTGRES_PORT=55432

# --- Application database (must match the values above)
DATABASE_URL=postgres://cartignon:replace-with-local-password@127.0.0.1:55432/cartignon

# --- Game server (apps/server)
PORT=2567
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
LOG_LEVEL=info
ROOM_IDLE_TIMEOUT_MINUTES=10
ROOM_FINISHED_TTL_SECONDS=60
ROOM_MAX_LIFETIME_MINUTES=720
SEAT_CLAIM_TIMEOUT_SECONDS=60
# Match clocks (R7; seconds, fractions allowed): turn clock, choice clock, pause budget per seat
TURN_TIMEOUT_SECONDS=900
CHOICE_TIMEOUT_SECONDS=60
PAUSE_BUDGET_SECONDS=180
MAX_LIVE_ROOMS=1000
# cartignon (default) | synthetic — rules module for new matches
MATCH_RULES=cartignon
# none (default) | loopback — trust X-Forwarded-For only from a reverse proxy on loopback (Caddy)
TRUSTED_PROXY=none
# Production (NODE_ENV=production) refuses to start unless ALLOWED_ORIGINS is https-only and
# COOKIE_SECURE=true.

# --- LAN playtest (pnpm dev:lan, docs/PLAYTEST.md). The LAN address is detected automatically and
# added to ALLOWED_ORIGINS for that run; set this only if the printed address is the wrong one.
# LAN_HOST=192.168.1.23

# --- Integration tests start their own throwaway Postgres by default. Uncomment only to run them
# against an already running server instead (role needs CREATEDB).
# TEST_DATABASE_URL=postgres://cartignon:replace-with-local-password@127.0.0.1:55432/cartignon
