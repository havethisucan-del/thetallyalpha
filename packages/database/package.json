{
  "name": "@cartignon/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -b && node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "db:start": "tsc -b && node --env-file-if-exists=../../.env dist/cli/dev-server.js start",
    "db:stop": "tsc -b && node --env-file-if-exists=../../.env dist/cli/dev-server.js stop"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
